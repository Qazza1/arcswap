{
  "rewrites": [
    { "source": "/circle-proxy/:path*", "destination": "https://api.circle.com/:path*" }
  ],
  "routes": [
    { "src": "/multisend",  "dest": "/multisend.html" },
    { "src": "/multisend/", "dest": "/multisend.html" },
    { "src": "/pay",        "dest": "/pay.html" },
    { "src": "/pay/",       "dest": "/pay.html" },
    { "src": "/invoice",    "dest": "/invoice.html" },
    { "src": "/invoice/",   "dest": "/invoice.html" },
    { "src": "/history",    "dest": "/history.html" },
    { "src": "/history/",   "dest": "/history.html" },
    { "src": "/analytics",  "dest": "/analytics.html" },
    { "src": "/analytics/", "dest": "/analytics.html" },
    { "src": "/docs",     "dest": "/docs.html" },
    { "src": "/docs/",      "dest": "/docs.html" },
    { "src": "/pricing",    "dest": "/pricing.html" },
    { "src": "/pricing/",   "dest": "/pricing.html" },
    { "src": "/security",   "dest": "/security.html" },
    { "src": "/security/",   "dest": "/security.html" },
    { "src": "/ecosystem",  "dest": "/ecosystem.html" },
    { "src": "/ecosystem/", "dest": "/ecosystem.html" }
  ]
}
