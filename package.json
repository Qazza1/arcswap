{
  "name": "fx-swap-widget",
  "version": "0.2.0",
  "description": "ArcFX — Stablecoin FX exchange on Arc. Swap, Bridge, Multisend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "compile:contracts": "hardhat compile --config hardhat.config.cjs",
    "deploy:multisender": "hardhat run scripts/deploy-multisender.cjs --network arc_testnet --config hardhat.config.cjs",
    "deploy:multisender:local": "hardhat run scripts/deploy-multisender.cjs --network hardhat --config hardhat.config.cjs",
    "prepare:mainnet-release": "node script/prepare-mainnet-release.mjs",
    "deploy:mainnet": "hardhat run scripts/deploy-mainnet.cjs --network arc_mainnet --config hardhat.config.cjs",
    "test:mainnet-release": "node --test script/mainnet-release.test.mjs",
    "check:deployments": "node script/deployments.mjs check",
    "check:release-config": "node script/release-config.mjs",
    "write:deployments": "node script/deployments.mjs write",
    "check:csp": "node script/csp-guard.mjs",
    "test:session-auth": "node --test script/session-auth.test.mjs",
    "test:payer-mainnet": "node --test script/payer-mainnet.test.mjs",
    "verify": "node script/preflight.mjs && tsc --noEmit && node --test script/session-auth.test.mjs && vite build && node script/csp-guard.mjs && hardhat compile --config hardhat.config.cjs && node --test script/mainnet-release.test.mjs && node script/release-config.mjs && node script/deployments.mjs check",
    "preflight": "node script/preflight.mjs",
    "fix:lock": "node script/fixlock.mjs"
  },
  "dependencies": {
    "@circle-fin/adapter-viem-v2": "^1.0.0",
    "@circle-fin/app-kit": "^1.0.0",
    "ethers": "^6.17.0",
    "jspdf": "^4.2.1",
    "preline": "^4.2.0",
    "viem": "^2.55.19"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "dotenv": "^16.0.0",
    "hardhat": "^2.22.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
